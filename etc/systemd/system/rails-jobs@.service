[Unit]
Description=Rails job queue runner (%i) for the OpenGeofiction site
Wants=postgresql.service memcached.service
After=network.target postgresql.service memcached.service

[Service]
Type=simple
User=ogf
Group=ogf
WorkingDirectory=/var/www/html/opengeofiction.net
# RAILS_ENV and SECRET_KEY_BASE, shared with the Apache/Passenger vhost
EnvironmentFile=/etc/opengeofiction/rails.env
Environment=QUEUE=%i
Environment=SLEEP_DELAY=60
ExecStart=/usr/bin/bundle exec rails jobs:work
Restart=on-failure
Nice=10
MemoryHigh=1G
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
