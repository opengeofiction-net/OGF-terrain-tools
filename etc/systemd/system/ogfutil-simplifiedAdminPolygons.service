[Unit]
Description=Generate simplified admin polygons from mapping data
RequiresMountsFor=/opt/opengeofiction

[Service]
User=ogf
Group=ogf
ExecStart=/opt/opengeofiction/ogf-server-scripts/bin/simplifiedAdminPolygons.py -od /opt/opengeofiction/simplified-territories -copyto /opt/opengeofiction/sync-to-ogf/utility

[Install]
WantedBy=default.target
